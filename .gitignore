# Android APKs ship via CLI deploys (public/app/), not git history
public/app/*.apk

# Snapshot exports — generated by the manus-to-live pipeline.
# ALL snapshot JSON files are gitignored (they are build artifacts, refreshed
# 3x daily). Deploy them via CI (deploy-snapshots-to-prod.sh / 
# deploy-snapshots-to-cloudflare.sh) so the built working tree is uploaded;
# they never need to live in git.
public/snapshots/latest/*.json
backend/snapshots/
*.db.gz

# Local agent session scratch
.agents/
.codex/
.qoder/

# Native Android app (android/) — build outputs & machine-local files
android/.gradle/
android/.kotlin/
android/app/build/
android/**/build/
android/local.properties
android/*.log
android/*.err
android/*.status
*.apk
*.aab
*.ap_
*.dex

# Signing keys — never commit new ones. The only tracked exception is the
# documented public dev identity android/ci-signing.keystore
# (docs/ANDROID_SIGNING.md); rotate via ANDROID_KEYSTORE_* secrets, then
# git rm --cached it after the secret-keyed release reaches all devices.
*.keystore
# Preview/debug-only key (passwords "android", lk.motormila.app.debug only, never release):
!android/app/preview-debug.keystore
*.jks

# Database snapshots & checkpoints (contain live data — never commit)
backend/db_snapshots/
backend/scrape_checkpoints/
backend/rescue_exports/
# Scraped Manus dumps: live listings incl. seller contact details. Keep them out
# of git entirely and hand them around via release assets / R2 instead.
data/manus-dumps/
/PROJECT.md
/ORIGINAL_REQUEST.md
.env*

# Local Hugging Face Space API dump (runtime status scratch)
space.json

# Generated at build/export time by scripts/build-snapshot-indexes.mjs
public/snapshots/latest/idx/
public/snapshots/latest/idx.tmp-*/
public/sitemap-hubs.xml
public/sitemap-listings-*.xml
public/sitemap-index.xml
