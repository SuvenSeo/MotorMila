# Cloudflare Pages headers — mirrors vercel.json for the future Pages cutover.
# Vercel ignores this file, so it is safe to ship before migration.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
/snapshots/*
  Cache-Control: public, max-age=300, stale-while-revalidate=60
  Access-Control-Allow-Origin: *
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
# INTERIM (merge review 2026-10-19): legal pages stay out of the index until
# the company is registered and a lawyer reviews the PDPA wording.
/privacy
  X-Robots-Tag: noindex, nofollow
/terms
  X-Robots-Tag: noindex, nofollow
/cookies
  X-Robots-Tag: noindex, nofollow
/removal
  X-Robots-Tag: noindex, nofollow
/delete-account
  X-Robots-Tag: noindex, nofollow
# Utility / account routes: never indexed (mirrors vercel.json; the shells also carry meta robots).
/sign-in
  X-Robots-Tag: noindex, nofollow
/sign-up
  X-Robots-Tag: noindex, nofollow
/profile
  X-Robots-Tag: noindex, nofollow
