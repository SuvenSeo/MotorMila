<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Location permissions removed (2026-10 overhaul): EV chargers fall back
         to Colombo and never requested them; declaring unused location
         permissions complicates the Play Data safety form. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".MotormilaApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Motormila"
        android:supportsRtl="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Motormila">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link: motormila://listing/{id} -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="motormila"
                    android:host="listing" />
            </intent-filter>
            <!-- Deep link: motormila://scan (QS tile + shortcut). -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="motormila"
                    android:host="scan" />
            </intent-filter>
            <!-- Shortcuts + in-app deep links: search, watchlist, home/picks, ev, pulse. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="motormila" android:host="search" />
                <data android:scheme="motormila" android:host="watchlist" />
                <data android:scheme="motormila" android:host="home" />
                <data android:scheme="motormila" android:host="picks" />
                <data android:scheme="motormila" android:host="ev" />
                <data android:scheme="motormila" android:host="pulse" />
                <data android:scheme="motormila" android:host="calculator" />
                <data android:scheme="motormila" android:host="cars" />
                <data android:scheme="motormila" android:host="make" />
                <data android:scheme="motormila" android:host="locations" />
                <data android:scheme="motormila" android:host="pricing" />
                <data android:scheme="motormila" android:host="docs" />
                <data android:scheme="motormila" android:host="admin" />
                <data android:scheme="motormila" android:host="chargers" />
                <data android:scheme="motormila" android:host="ev-chargers" />
                <data android:scheme="motormila" android:host="privacy" />
                <data android:scheme="motormila" android:host="terms" />
                <data android:scheme="motormila" android:host="permits" />
                <data android:scheme="motormila" android:host="price-index" />
                <data android:scheme="motormila" android:host="trends" />
                <data android:scheme="motormila" android:host="guide" />
                <data android:scheme="motormila" android:host="pro" />
                <data android:scheme="motormila" android:host="estimate" />
                <data android:scheme="motormila" android:host="compare" />
                <data android:scheme="motormila" android:host="dealer" />
                <data android:scheme="motormila" android:host="settings" />
                <data android:scheme="motormila" android:host="alerts" />
                <data android:scheme="motormila" android:host="login" />
                <data android:scheme="motormila" android:host="sign-in" />
                <data android:scheme="motormila" android:host="sign-up" />
                <data android:scheme="motormila" android:host="best-picks" />
                <data android:scheme="motormila" android:host="notifications" />
                <data android:scheme="motormila" android:host="sell" />
            </intent-filter>
            <!-- Verified App Links: requires https://motormila.pages.dev/.well-known/assetlinks.json
                 listing the Play app-signing + direct-release cert SHA-256 (OPS step). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Shared web searches: the web keeps filters on the root URL ("/?make=Toyota&fuel_type=hybrid")
                     or /search?…; resolveMotormilaDeepLink maps them to Search with the same filters. -->
                <data android:scheme="https" android:host="motormila.pages.dev" android:path="/" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/search" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/listing" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/cars" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/locations" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/calculator" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/estimate" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/best-picks" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/compare" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/dealer" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/settings" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/alerts" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/sign-in" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/sign-up" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/pro" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/official-pulse" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/pricing" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/docs" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/admin" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/privacy" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/terms" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/permits" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/price-index" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/trends" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/ev-chargers" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/ev-hub" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/notifications" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/sell" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/valuation" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/profile" />
                <data android:scheme="https" android:host="motormila.pages.dev" android:pathPrefix="/delete-account" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Receives ACTION_SEND text/plain from browsers / classifieds apps.
             Forwards the shared URL into MainActivity via the share-import route. -->
        <activity
            android:name=".ShareImportActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Motormila.Trampoline">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Quick Settings tile for plate scan. Implementation owned by the UI
             builder: lk.motormila.app.ui.scan.ScanTileService -->
        <service
            android:name="lk.motormila.app.ui.scan.ScanTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/tile_scan_plate"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Deal-of-the-day widget (Swarm E additive; Agent A: no existing entries touched). -->
        <receiver
            android:name="lk.motormila.app.ui.widget.DealWidgetProvider"
            android:exported="false"
            android:label="@string/widget_deal_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/deal_widget_info" />
        </receiver>

        <!-- Share-card PNGs written to cacheDir/share (FmvShare). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- AppCompat per-app language on API 26-32: persists the chosen locale
             and re-applies it at startup (API 33+ uses the platform LocaleManager). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Hilt-injected WorkManager (MotormilaApp implements Configuration.Provider):
             disable the default initializer so our HiltWorkerFactory is used. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
