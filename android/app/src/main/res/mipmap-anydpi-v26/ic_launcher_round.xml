<?xml version="1.0" encoding="utf-8"?>
<!-- Brand mark (public/logo-mark.png) on Ink #09090B. Foreground is a
     density-specific bitmap of the exact web artwork, scaled so the whole
     mark (arrow tip included) sits inside the 66dp safe zone. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launcher_bg" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
