    <string name="hub_ev_upgrade_title">Pro-இல் மேலும் EV மாடல்கள்</string>
    <string name="hub_ev_upgrade_body">இலவசம் முதல் 3 EV மாடல்களைக் காட்டுகிறது. Pro முழு தரவரிசை EV பலகையைத் திறக்கிறது.</string>
    <string name="hub_ev_tco_eyebrow">TCO ஒப்பீடு</string>
    <string name="hub_ev_tco_title">EV vs. பெட்ரோல் — உண்மையான இயக்க செலவு</string>
    <string name="hub_ev_tco_body">ஆண்டு எரிபொருள் சேமிப்பு %1$s (கி.மீ.க்கு LKR %2$d vs LKR %3$d, ஆண்டுக்கு %4$dk கி.மீ.).</string>
    <string name="hub_ev_tco_petrol_label">பெட்ரோல்</string>
    <string name="hub_ev_tco_ev_label">EV (ஆஃப்-பீக்)</string>
    <string name="hub_ev_tco_per_km">LKR %1$d/கி.மீ.</string>
    <string name="hub_ev_tco_savings_label">ஆண்டு எரிபொருள் சேமிப்பு</string>
    <string name="hub_ev_tco_payback_label">எரிபொருள் சேமிப்பு திரும்பப் பெறல்</string>
    <string name="hub_ev_tco_payback_value">~%1$d ஆண்டுகள்</string>
    <string name="hub_ev_tco_payback_note">EV விலை உயர்வை மீட்க</string>
    <string name="hub_ev_tco_disclaimer">குறிப்பிற்கு மட்டும். உண்மையான சேமிப்பு சார்ஜிங் செலவு, மைலேஜ் மற்றும் மாடலைப் பொறுத்து மாறும்.</string>
    <string name="hub_ev_aqua_label">Toyota Aqua அளவுகோல்</string>
    <string name="hub_ev_modules">முடிவு தொகுதிகள்</string>
    <string name="hub_ev_module_battery_title">பேட்டரி ஆரோக்கியம்</string>
    <string name="hub_ev_module_battery_body">தேய்மானப் போக்குகள், SoH அளவுகோல்கள், வாங்குவதற்கு முன் பார்க்க வேண்டியவை. OBD-II அறிக்கையை வலியுறுத்தி 20–30% இருப்பு இடத்தை வைத்திருங்கள்.</string>
    <string name="hub_ev_module_battery_step">01</string>
    <string name="hub_ev_module_duty_title">வரி &amp; கொள்கை</string>
    <string name="hub_ev_module_duty_body">இலங்கை EV இறக்குமதி வரி விகிதங்கள், விலக்குகள் மற்றும் கொள்கை நோக்கு. கிளியரன்ஸுக்கு முன் HS குறியீட்டு அரசிதழ் வகைப்பாட்டை உறுதிப்படுத்தவும்.</string>
    <string name="hub_ev_module_duty_step">02</string>
    <string name="hub_ev_module_charging_title">சார்ஜிங் பொருத்தம்</string>
    <string name="hub_ev_module_charging_body">இரவு 7 kW AC வீட்டு சார்ஜிங் கி.மீ.க்கு சுமார் LKR 6; பெட்ரோலுக்கு LKR 28. பொது DC E01/E02 மற்றும் கண்டி/காலி பாதைகளை உள்ளடக்குகிறது.</string>
    <string name="hub_ev_module_charging_step">03</string>
