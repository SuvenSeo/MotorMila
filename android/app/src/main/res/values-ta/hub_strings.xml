    <!-- EV Hub -->
    <string name="hub_ev_title">EV மையம்</string>
    <string name="hub_ev_eyebrow">EV நுண்ணறிவு</string>
    <string name="hub_ev_headline">EV வாங்கும் சமிக்ஞைகள்.</string>
    <string name="hub_ev_description">இலங்கை EV சந்தைக்கான பேட்டரி ஆரோக்கியம், சார்ஜிங் பொருத்தம் மற்றும் வரி சமிக்ஞைகள்.</string>
    <string name="hub_ev_live_inventory">நேரடி EV சரக்கு</string>
    <string name="hub_ev_count_label">நேரடி மின் பட்டியல்கள்</string>
    <string name="hub_ev_count_note">அனைத்து மூலங்களிலும் செயலில் உள்ள EV சரக்கு கண்காணிக்கப்படுகிறது</string>
    <string name="hub_ev_share_label">EV சந்தை பங்கு</string>
    <string name="hub_ev_share_note">கண்காணிக்கப்பட்ட அனைத்து பட்டியல்களிலும் மின்சார பங்கு</string>
    <string name="hub_ev_median_label">EV சராசரி விலை</string>
    <string name="hub_ev_median_note">விலையிடப்பட்ட அனைத்து EV பட்டியல்களின் மத்திய விலை</string>
    <string name="hub_ev_share_value">%1$.1f%%</string>
    <string name="hub_ev_top_models">முதன்மை EV மாடல்கள்</string>
