<?xml version="1.0" encoding="utf-8"?>
<!-- Swarm E: RemoteViews layout for the Deal-of-the-day widget.
     RemoteViews supports only LinearLayout/TextView/ImageView — no Compose. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/motormila_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_index"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/widget_deal_desc"
            android:text="@string/widget_index_missing"
            android:textColor="@color/motormila_gold"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_mom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_deal_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:contentDescription="@string/widget_open_deal"
        android:ellipsize="end"
        android:maxLines="2"
        android:minHeight="48dp"
        android:text="@string/widget_deal_title"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_deal_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:minHeight="48dp"
        android:text=""
        android:textColor="@color/motormila_deal"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
