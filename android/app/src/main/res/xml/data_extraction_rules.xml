<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ data extraction rules (cloud + device transfer).
     DataStore lives under files/datastore/, not sharedpref — without the
     file-domain excludes the auth JWT is copied to Google Drive / new device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="session.preferences_pb" />
        <exclude domain="sharedpref" path="settings.preferences_pb" />
        <exclude domain="sharedpref" path="deal_widget.preferences_pb" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="datastore/session.preferences_pb" />
        <exclude domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="database" path="motormila.db" />
        <exclude domain="database" path="motormila.db-journal" />
        <exclude domain="database" path="motormila.db-wal" />
        <exclude domain="database" path="motormila.db-shm" />
        <exclude domain="file" path="coil/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session.preferences_pb" />
        <exclude domain="sharedpref" path="settings.preferences_pb" />
        <exclude domain="sharedpref" path="deal_widget.preferences_pb" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="datastore/session.preferences_pb" />
        <exclude domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="file" path="coil/" />
    </device-transfer>
</data-extraction-rules>
