# Motormila — Backend Environment Configuration
# Copy this to .env and fill in your values

# PostgreSQL connection (Neon POOLED connection string recommended — see
# docs/neon-egress-budget.md). Example format:
# postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Hugging Face Spaces: set these as Space secrets (Settings → Variables and secrets)
# Neon-first single-DB mode: only HOT_DATABASE_URL is required; COLD falls back
# to it when unset.
# HOT_DATABASE_URL=postgresql://...   (Neon pooled DSN — reads + writes)
# COLD_DATABASE_URL=postgresql://...  (optional write-target override)
# ALLOW_SQLITE_FALLBACK=false
# CORS_ORIGINS=https://motormila.vercel.app,https://vehicle-platform-one.vercel.app,http://localhost:5173
# DAILY_SYNC_RUN_ON_STARTUP=false   (recommended — sync on startup can delay API for ~90 min)
# DAILY_SYNC_ENABLED=false (GitHub Actions owns production scraping)

# Set to false in production to fail fast when DATABASE_URL is missing.
ALLOW_SQLITE_FALLBACK=true

# Admin API key (keep secret — used to trigger scrapers)
ADMIN_API_KEY=your-secret-admin-key-here

# Comma-separated frontend origins for CORS (include your Vercel production URL)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,https://motormila.vercel.app,https://vehicle-platform-one.vercel.app

# --- Pro gate (HF Space secret) ---
# ENFORCED BY DEFAULT: every /api/v1/pro/* route requires a valid
# pro/enterprise token unless you explicitly set this to false (local dev only).
# Pair with VITE_PRO_ACCESS_ENFORCED=true on Vercel so export UI matches the API.
# PRO_ACCESS_ENFORCED=false   # local development opt-out only

# --- Weekly Pro digest (GitHub Actions secrets / HF optional) ---
# SENDGRID_API_KEY=SG.xxx
# DIGEST_RECIPIENTS=dealer@example.com,ops@example.com
# DIGEST_FROM_EMAIL=hello@ardenostudio.com
# DIGEST_SUBJECT=Motormila Pro — Weekly Market Digest

# --- Optional runtime caps ---
# SSE_MAX_CONNECTIONS=50
# LIVE_STREAM_INTERVAL_SECONDS=120   # default raised from 10s to cut DB rebuilds
# DISABLE_LIVE_SSE=true              # egress incidents: reject /stats/live/stream
# RUN_THUMBNAIL_CACHE=false
# THUMBNAIL_BATCH_LIMIT=100
# CDN_BASE_URL=

# --- Real Pro authentication ---
# Required in production now that PRO_ACCESS_ENFORCED defaults to true.
# AUTH_TOKEN_SECRET=<long-random-string>
# AUTH_TOKEN_TTL_SECONDS=86400
# AUTH_INVITE_TTL_DAYS=14
# Cross-origin cookie session (Vercel → HF): Secure + SameSite=None by default.
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=none
# Passwords are bcrypt hashes only (legacy unsalted SHA-256 entries are rejected).
# Generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
# Bootstrap admin (synced into platform_users on first login):
# AUTH_USERS=[{"email":"owner@example.com","password_hash":"$2b$12$...","name":"Owner","plan":"enterprise","subscription_status":"active","role":"admin"}]
#
# App-wide API gate (default ON): listings/stats/market/etc require a signed-in
# session. Opt out only for local open demos / unit tests.
# APP_ACCESS_ENFORCED=false
# PRO_ACCESS_ENFORCED=false   # local development opt-out only

# --- Rate limiting (optional, Redis) ---
# When REDIS_URL is set, rate limiting uses Redis sliding-window (shared across
# workers, survives restarts). Without it, falls back to in-memory per-process.
# REDIS_URL=redis://default:your-password@your-redis-host:6379/0

# --- Error tracking (optional, Sentry) ---
# No-op unless SENTRY_DSN is set.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0

# --- WhatsApp market-alert notifications (optional, Twilio) ---
# When set, alert match deltas with notify_phone send a WhatsApp message.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Telegram market-alert notifications (optional) ---
# When set, alert match deltas with notify_telegram_chat_id send a Telegram message.
# TELEGRAM_BOT_TOKEN=123456789:ABCdef...

# --- Scraper anti-ban (optional, off by default) ---
# SCRAPE_PROXY_URL=http://user:pass@proxy:8080
# SCRAPE_PROXIES=http://p1:8080,http://p2:8080
# SCRAPE_ROTATE_UA=true
# SCRAPE_ROTATE_VIEWPORT=true
# SCRAPE_STEALTH=true

# --- B2B collateral-value API (banks / leasing companies) ---
# Comma-separated static API keys, one per institution. The /api/v1/b2b/*
# endpoints return 503 until at least one key is set. Issue keys out-of-band.
# B2B_API_KEYS=inst-abc-longrandomkey,inst-xyz-anotherkey

# --- AI chat assistant (optional, Groq) ---
# GROQ_API_KEY=
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# GROQ_MODEL=llama-3.1-8b-instant

# --- In-Space scheduler (optional, off by default — see README §8) ---
# DAILY_SYNC_ENABLED=false
# DAILY_SYNC_RUN_ON_STARTUP=false
# DAILY_SYNC_HOURS=6,18   (comma-separated 0-23; default [6, 18] if unset)
# DAILY_SYNC_TIMEZONE=Asia/Colombo
# DAILY_SYNC_PROFILE=daily
# DAILY_SYNC_TIMEOUT_SECONDS=5400

# --- Dealer verify / billing (ops) ---
# Protects POST /dealer/verify — marks a claim as verified and sets plan/subscription.
# DEALER_ADMIN_TOKEN=long-random-ops-token

# --- Billing checkout (POST /api/v1/billing/checkout-intent) ---
# Set one of these to redirect Pro/Dealer CTAs to a real checkout page.
# If neither is set the endpoint returns a "contact sales" message with the
# support email from BILLING_CONTACT_EMAIL (defaults to the brand address).
# BILLING_CHECKOUT_URL=https://checkout.example.com/session
# PAYHERE_CHECKOUT_URL=https://sandbox.payhere.lk/pay/checkout
# STRIPE_CHECKOUT_URL=https://buy.stripe.com/your-payment-link
# BILLING_CONTACT_EMAIL=suvenseoras@gmail.com
# BILLING_WHATSAPP_NUMBER=0758504424

# --- Neon egress budget ---
# Public browsing reads R2 snapshots (VITE_SNAPSHOT_ONLY=true) so it never
# touches Postgres. Full-catalog snapshot exports + pg_dump run weekly; daily
# exports use --skip-catalog. See docs/neon-egress-budget.md and
# .github/workflows/neon-egress-watch.yml (weekly budget watchdog).
# HOT_DATABASE_URL=<neon pooled dsn>   # port 6543 / -pooler endpoint

# --- Third-party enrichment (server-side keys only; never expose via Vite) ---
# Safety/reliability research is on by default (NHTSA is public, no key).
# ENRICHMENT_NHTSA_SAFETY=true
# ENRICHMENT_PROBLEMSBYVIN=true
# ENRICHMENT_OPEN_CHARGE_MAP=true
# ENRICHMENT_GEOAPIFY=false
# Enable only after `scripts/sample_geoapify.py --limit 100` shows an acceptable match rate.
# ENRICHMENT_REVCARDATA=false
# Pilot only — run `scripts/pilot_revcardata.py` before considering a catalog.
# ENRICHMENT_SMARTCAR=false
# Smartcar is a product brief only — do not enable or build a live-data path.
# ENRICHMENT_MIN_MATCH_CONFIDENCE=0.6
# OPENCHARGEMAP_API_KEY=
# GEOAPIFY_API_KEY=
# REVCARDATA_API_KEY=

# --- Security / outage hardening (overhaul/backend-sec) ---------------------
# AUTH_COOKIE_SAMESITE=lax            # default lax; "none" only for deliberate cross-site setups
# CORS_ORIGINS=                       # extra allowed origins (extends defaults); "*" disables credentials
# CORS_ORIGINS_REPLACE=false
# CSRF_PROTECTION=true                # cookie-only writes need a trusted Origin/Referer
# API_DOCS_ENABLED=                   # default: off on HF Spaces / ENV=production
# SECURITY_CONTACT=mailto:security@example.com
# DB_CONNECT_TIMEOUT_SECONDS=3
# DB_BREAKER_OPEN_SECONDS=15
# DB_RETRY_AFTER_SECONDS=30
# SQLITE_FAILOVER_SOCKET_TIMEOUT=120
# SQLITE_FAILOVER_DOWNLOAD_DEADLINE=1800
# SQLITE_FAILOVER_SLIM_URL=           # url, or "default" for snapshots/latest/merged-motormila-slim.db.gz
# SQLITE_FAILOVER_USER_AGENT=
# BILLING_WEBHOOK_TOLERANCE_SECONDS=300
# BILLING_WEBHOOK_ALLOW_LEGACY=false
# LOGIN_ACCOUNT_MAX_FAILURES=5
# LOGIN_IP_MAX_FAILURES=30
# LOGIN_FAILURE_WINDOW_SECONDS=900
# LOGIN_MAX_LOCKOUT_SECONDS=900
